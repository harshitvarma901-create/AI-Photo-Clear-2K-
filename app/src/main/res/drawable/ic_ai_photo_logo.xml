<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#070B19"
                android:centerColor="#122347"
                android:endColor="#3B0764" />
        </shape>
    </item>

    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#0D162E" />
            <stroke
                android:width="4dp"
                android:color="#38BDF8" />
        </shape>
    </item>

    <item
        android:top="32dp"
        android:bottom="32dp"
        android:left="32dp"
        android:right="32dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#38BDF8"
                android:centerColor="#A855F7"
                android:endColor="#F472B6" />
        </shape>
    </item>
</layer-list>
